{
  "$id": "https://bali-music-video-editor.local/schemas/reframe-overrides/1.0.0",
  "title": "Bali human reframe overrides (Phase 5.1; crop-only, applied at execution)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "kind": {
      "type": "string",
      "const": "HUMAN_REFRAME_OVERRIDES"
    },
    "projectId": {
      "type": "string"
    },
    "planId": {
      "type": "string"
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^usr:"
          },
          "kind": {
            "type": "string",
            "const": "HUMAN_REFRAME_OVERRIDE"
          },
          "clipId": {
            "type": "string"
          },
          "mediaId": {
            "type": "string"
          },
          "shotId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PROPOSED",
              "APPROVED"
            ]
          },
          "option": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "static",
              "tracked"
            ]
          },
          "centerX": {
            "type": "number"
          },
          "path": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sourceTime": {
                  "type": "object",
                  "properties": {
                    "num": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "den": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "num",
                    "den"
                  ],
                  "additionalProperties": false,
                  "description": "Exact rational number num/den (normalized)."
                },
                "centerX": {
                  "type": "number"
                }
              },
              "required": [
                "sourceTime",
                "centerX"
              ],
              "additionalProperties": false
            }
          },
          "offsetX": {
            "type": "number"
          },
          "smoothingFrames": {
            "type": "integer",
            "minimum": 1,
            "maximum": 61
          },
          "subjectTrack": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sourceTime": {
                  "type": "object",
                  "properties": {
                    "num": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "den": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "num",
                    "den"
                  ],
                  "additionalProperties": false,
                  "description": "Exact rational number num/den (normalized)."
                },
                "centerX": {
                  "type": "number"
                }
              },
              "required": [
                "sourceTime",
                "centerX"
              ],
              "additionalProperties": false
            }
          },
          "basis": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "date": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "clipId",
          "mediaId",
          "shotId",
          "status",
          "mode",
          "basis"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "projectId",
    "planId",
    "overrides"
  ],
  "additionalProperties": false
}
