{
  "$id": "https://bali-music-video-editor.local/schemas/fx-effect/1.0.0",
  "title": "Bali FX effect instance (Phase 6A; anchored, bounded, deterministic)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^fx:[a-z0-9-]+$"
    },
    "type": {
      "type": "string",
      "enum": [
        "flashFrame",
        "microZoom",
        "cameraPunch",
        "frameRepeat",
        "temporalStutter",
        "rgbSplit",
        "speedRamp",
        "freezeFrame",
        "echoTrail",
        "filmTexture"
      ]
    },
    "enabled": {
      "default": true,
      "type": "boolean"
    },
    "clipId": {
      "type": "string"
    },
    "anchor": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "frame"
            },
            "frame": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "frame"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "time"
            },
            "time": {
              "type": "object",
              "properties": {
                "num": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "den": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "num",
                "den"
              ],
              "additionalProperties": false,
              "description": "Exact rational number num/den (normalized)."
            }
          },
          "required": [
            "kind",
            "time"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "musicEvent"
            },
            "eventId": {
              "type": "string"
            },
            "offsetFrames": {
              "default": 0,
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "eventId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "durationFrames": {
      "type": "integer",
      "minimum": 1,
      "maximum": 90
    },
    "preset": {
      "type": "string",
      "enum": [
        "SUBTLE",
        "MEDIUM",
        "STRONG"
      ]
    },
    "intensity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "mix": {
      "default": 1,
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "seed": {
      "default": 1,
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "envelope": {
      "type": "object",
      "properties": {
        "attack": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "hold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "release": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "curve": {
          "type": "string",
          "enum": [
            "linear",
            "smooth",
            "exp"
          ]
        }
      },
      "required": [
        "attack",
        "hold",
        "release",
        "curve"
      ],
      "additionalProperties": false
    },
    "params": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "flashFrame"
            },
            "mode": {
              "type": "string",
              "const": "exposure"
            },
            "peakGain": {
              "type": "number",
              "minimum": 1,
              "maximum": 2.2
            }
          },
          "required": [
            "type",
            "mode",
            "peakGain"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "flashFrame"
            },
            "mode": {
              "type": "string",
              "const": "screen"
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "peakOpacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.85
            }
          },
          "required": [
            "type",
            "mode",
            "color",
            "peakOpacity"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "microZoom"
            },
            "peakScale": {
              "type": "number",
              "minimum": 1,
              "maximum": 1.25
            },
            "focusX": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "focusY": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "type",
            "peakScale",
            "focusX",
            "focusY"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "cameraPunch"
            },
            "translatePx": {
              "type": "number",
              "minimum": 0,
              "maximum": 80
            },
            "angleDeg": {
              "type": "number"
            },
            "scalePunch": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.1
            },
            "rotateDeg": {
              "type": "number",
              "minimum": -3,
              "maximum": 3
            },
            "oscillations": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 3
            }
          },
          "required": [
            "type",
            "translatePx",
            "angleDeg",
            "scalePunch",
            "rotateDeg",
            "oscillations"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "frameRepeat"
            },
            "mode": {
              "type": "string",
              "const": "hold"
            },
            "sourceFrame": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "mode",
            "sourceFrame"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "frameRepeat"
            },
            "mode": {
              "type": "string",
              "const": "step"
            },
            "pattern": {
              "minItems": 1,
              "maxItems": 32,
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              }
            }
          },
          "required": [
            "type",
            "mode",
            "pattern"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "temporalStutter"
            },
            "loop": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "repeats": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "shrink": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "loop",
            "repeats",
            "shrink"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "rgbSplit"
            },
            "offsetPx": {
              "type": "number",
              "minimum": 0,
              "maximum": 24
            },
            "angleDeg": {
              "type": "number"
            }
          },
          "required": [
            "type",
            "offsetPx",
            "angleDeg"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "speedRamp"
            },
            "profile": {
              "type": "string",
              "enum": [
                "surge",
                "dip"
              ]
            },
            "amount": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 0.8
            }
          },
          "required": [
            "type",
            "profile",
            "amount"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "freezeFrame"
            },
            "sourceFrame": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "sourceFrame"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "echoTrail"
            },
            "trails": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            },
            "spacing": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "decay": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 0.95
            },
            "blend": {
              "type": "string",
              "enum": [
                "lighten",
                "darken",
                "screen",
                "normal"
              ]
            }
          },
          "required": [
            "type",
            "trails",
            "spacing",
            "decay",
            "blend"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "filmTexture"
            },
            "grainSize": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "amount": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.35
            },
            "chroma": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "flicker": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.04
            }
          },
          "required": [
            "type",
            "grainSize",
            "amount",
            "chroma",
            "flicker"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "id",
    "type",
    "clipId",
    "anchor",
    "durationFrames",
    "intensity"
  ],
  "additionalProperties": false
}
