{
  "$id": "https://bali-music-video-editor.local/schemas/music-sync/1.0.0",
  "title": "Bali music sync (user-authored events, patterns, overrides)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "sourceMediaId": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "requiredEvents": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^usr:[a-z0-9._-]+$"
          },
          "type": {
            "type": "string",
            "enum": [
              "structural_boundary",
              "start_boundary",
              "end_boundary",
              "vocal_hit",
              "custom"
            ]
          },
          "time": {
            "type": "string",
            "minLength": 2
          },
          "label": {
            "type": "string"
          },
          "mandatory": {
            "default": true,
            "type": "boolean"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "time",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "requiredPatterns": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^usr:[a-z0-9._-]+$"
          },
          "label": {
            "type": "string"
          },
          "window": {
            "type": "object",
            "properties": {
              "start": {
                "type": "string",
                "minLength": 2
              },
              "end": {
                "type": "string",
                "minLength": 2
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          "matchEventTypes": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "onset",
                "vocal_attack",
                "impact",
                "drop"
              ]
            }
          },
          "requirement": {
            "type": "string",
            "const": "every_occurrence_mandatory"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "window",
          "matchEventTypes",
          "requirement"
        ],
        "additionalProperties": false
      }
    },
    "occurrenceGroundTruth": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "patternId": {
            "type": "string",
            "pattern": "^usr:[a-z0-9._-]+$"
          },
          "exhaustive": {
            "type": "boolean"
          },
          "referenceEventId": {
            "type": "string"
          },
          "occurrences": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^usr:[a-z0-9._-]+$"
                },
                "window": {
                  "type": "object",
                  "properties": {
                    "start": {
                      "type": "string",
                      "minLength": 2
                    },
                    "end": {
                      "type": "string",
                      "minLength": 2
                    }
                  },
                  "required": [
                    "start",
                    "end"
                  ],
                  "additionalProperties": false
                },
                "note": {
                  "type": "string"
                },
                "approval": {
                  "type": "object",
                  "properties": {
                    "primaryEventId": {
                      "type": "string"
                    },
                    "time": {
                      "type": "string",
                      "minLength": 2
                    },
                    "effectRepeatEventIds": {
                      "default": [],
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "approvedBy": {
                      "type": "string",
                      "const": "user"
                    },
                    "date": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "method": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "primaryEventId",
                    "time",
                    "approvedBy",
                    "date",
                    "method"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "window"
              ],
              "additionalProperties": false
            }
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "patternId",
          "exhaustive",
          "referenceEventId",
          "occurrences"
        ],
        "additionalProperties": false
      }
    },
    "eventOverrides": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^usr:[a-z0-9._-]+$"
          },
          "targetEventId": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "exclude",
              "confirm",
              "retime",
              "relabel",
              "pin"
            ]
          },
          "time": {
            "type": "string",
            "minLength": 2
          },
          "exactTime": {
            "type": "object",
            "properties": {
              "num": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "den": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "num",
              "den"
            ],
            "additionalProperties": false,
            "description": "Exact rational number num/den (normalized)."
          },
          "evidenceEventIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "approved": {
            "type": "object",
            "properties": {
              "by": {
                "type": "string",
                "const": "user"
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            },
            "required": [
              "by",
              "date"
            ],
            "additionalProperties": false
          },
          "label": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "targetEventId",
          "action"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "sourceMediaId"
  ],
  "additionalProperties": false
}
